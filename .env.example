# Application Environment
PORT=8080
APP_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:3000/distributed_jobs?sslmode=disable

# Redis Configuration (Streams, Pub/Sub, Cache)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-distributed-platform-2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Distributed Worker Settings
WORKER_NAME=worker-1
WORKER_CONCURRENCY=5
STREAM_NAME=jobs:stream
CONSUMER_GROUP=job-workers-group
DLQ_STREAM_NAME=jobs:dlq
CLAIM_MIN_IDLE_TIME=30s
OUTBOX_POLL_INTERVAL=200ms

# Redis Cache TTL
CACHE_TTL=1m

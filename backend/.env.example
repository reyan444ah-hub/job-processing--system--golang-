# Copy to .env for local Docker Compose use. Replace credentials before deployment.
PORT=8080
APP_ENV=development

# PostgreSQL (host must be "postgres" for Docker Compose, "localhost" for local Go runs)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=distributed_jobs
DATABASE_URL=postgres://postgres:local-dev-password@postgres:5432/distributed_jobs?sslmode=disable
POSTGRES_HOST_PORT=3000

# Redis Configuration (Streams, Pub/Sub, Cache)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_HOST_PORT=6379

# JWT Authentication: local-only example; use a unique random secret in production.
JWT_SECRET=local-only-change-this-secret-before-deployment
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
ALLOWED_ORIGINS=http://localhost:3000
API_HOST_PORT=8080

# Distributed Worker Settings
WORKER_NAME=worker-1
WORKER_CONCURRENCY=5
STREAM_NAME=jobs:stream
CONSUMER_GROUP=job-workers-group
DLQ_STREAM_NAME=jobs:dlq
CLAIM_MIN_IDLE_TIME=30s
OUTBOX_POLL_INTERVAL=200ms

# Redis Cache TTL
CACHE_TTL=1m
